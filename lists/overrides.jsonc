// Hand corrections applied by `jam lists build`. Source files in lists/sources/ are never edited.
{
  // Highest point of each prefecture, keyed by prefecture code. The point itself comes from
  // GSI's table (lists/sources/gsi-highpoints); this only adds English names for the four rows
  // that are not named summits, and notes.
  "prefectureHighpoints": {
    "05": {
      "en": "Chokaizan, east flank",
      "note": "On the eastern slope of 鳥海山. The summit, 新山 (2,236 m), is in Yamagata."
    },
    "18": {
      "en": "Sannomine, south top",
      "note": "The southern top of 三ノ峰, on the Fukui side. The main summit is outside Fukui."
    },
    "27": {
      "en": "Kongozan, south-east top",
      "note": "A top south-east of 金剛山's summit. The summit (1,125 m) is in Nara."
    },
    "30": {
      "note": "Named in 2009, next to 護摩壇山 (1,372 m)."
    },
    "40": {
      "en": "Shakadake, south-west top",
      "note": "The south-western top of 釈迦岳. The summit (1,231 m) is in Ōita."
    }
  },
  // Corrections to the prefecture column of GSI's mountain list, keyed by GSI row number.
  "gsiPrefectures": {
    // 櫛形山 (南アルプス市): the 2026-03-31 edition adds 長野県; the summit is 15 km from it.
    "588": ["19"]
  },
  // Notes added to single list items, keyed by item id.
  "itemNotes": {
    "nihyakumeizan-078": "Sakurajima's summit is closed because of volcanic activity. The list counts the 湯之平 observation point instead."
  },
  // Positions checked by hand for list items no source places, keyed by item id.
  "itemCoordinates": {
    // Not in GSI's list or OpenStreetMap; the Wikipedia article has no coordinates. YAMAP's
    // summit (1,357 m) and the EXIF position of a summit photo agree to within 20 m.
    "yamanashi-hyakumeizan-056": {
      "lat": 35.60961,
      "lon": 138.74247,
      "note": "Placed by hand at the summit as hiking maps (YAMAP) show it; no open source gives its position."
    },
    // The list's 1,235 m is the triangulation point 春日沢ノ頭; the signed summit, which the
    // prefecture's own grading table lists, is the 1,158 m top.
    "yamanashi-hyakumeizan-060": {
      "lat": 35.56557,
      "lon": 138.65754,
      "elevationM": 1158,
      "note": "Placed by hand at the signed 1,158 m summit. The 1,235 m the list gives is 春日沢ノ頭, the triangulation point on the same ridge."
    },
    // 続日本100名城's row links only 台場, the general article on coastal batteries. The castle is
    // 品川台場; its remaining part on land is 第三台場, now 台場公園 (position from that article).
    "zoku-nihon-100-meijo-124": {
      "lat": 35.6334944,
      "lon": 139.7718833,
      "ja": "品川台場",
      "en": "Shinagawa Daiba",
      "note": "Placed at 第三台場 (台場公園), the battery that can be visited; 第六台場 is closed to the public."
    },
    // 花の百名山, 関東百名山, 関西百名山: summits with no position on Wikidata or in their
