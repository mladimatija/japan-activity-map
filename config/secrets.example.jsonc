{
  // Copy to secrets.jsonc and fill in. The real file is git-ignored and is never read from this example.
  // "strava": {
  //   "clientId": "",
  //   "clientSecret": ""
  // },
  // Your YAMAP sign-in token, for `pnpm jam sync yamap`: the value of the yamap_token cookie
  // (docs/yamap.md). Easier: `pnpm jam yamap token` stores it for you.
  // "yamap": {
  //   "token": ""
  // },
  // A Garmin Connect personal API key, for `pnpm jam sync garmin` (docs/garmin.md).
  // "garmin": {
  //   "apiKey": ""
  // },
  // For `pnpm jam deploy` (docs/deploy.md), whichever host site.jsonc names. Cloudflare Pages: an
  // API token with Account > Cloudflare Pages > Edit, and the id of the account the project is
  // in. Netlify: a personal access token. GitHub Pages needs nothing here.
  // "deploy": {
  //   "apiToken": "",
  //   "accountId": "",
  //   "netlifyToken": ""
  // }
}
