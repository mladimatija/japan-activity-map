{
  "name": "japan-activity-map",
  "version": "0.0.0",
  "private": true,
  "description": "A personal map of Japan comparing famous peak, trail and route lists against your own activities.",
  "homepage": "https://github.com/mladimatija/japan-activity-map#readme",
  "bugs": "https://github.com/mladimatija/japan-activity-map/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mladimatija/japan-activity-map.git"
  },
  "type": "module",
  "scripts": {
    "jam": "node packages/cli/src/main.ts",
    "check": "vp check",
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "fix": "vp check --fix",
    "check:strava": "bash packages/cli/dev/check-strava.sh",
    "check:match": "node packages/cli/dev/check-match.ts",
    "check:routes": "node packages/cli/dev/check-routes.ts",
    "check:gpx": "node packages/cli/dev/check-gpx.ts",
    "check:garmin": "node packages/cli/dev/check-garmin.ts",
    "check:yamap": "node packages/cli/dev/check-yamap.ts",
    "check:lists": "node packages/cli/dev/check-lists.ts",
    "check:privacy": "node packages/cli/dev/check-privacy.ts",
    "check:build": "node packages/cli/dev/check-build.ts",
    "check:setup": "node packages/cli/dev/check-setup.ts",
    "check:setup-web": "node packages/cli/dev/check-setup-web.ts",
    "check:web": "sh packages/web/dev/check-web.sh",
    "check:bundle": "node packages/web/dev/check-bundle.ts",
    "check:demo": "node packages/cli/dev/check-demo.ts",
    "check:deploy": "node packages/cli/dev/check-deploy.ts",
    "check:web:demo": "node packages/web/dev/check-web-demo.ts",
    "demo:web": "node packages/web/dev/demo-web.ts",
    "demo:site": "node packages/web/dev/demo-site.ts",
    "check:setup-ui": "sh packages/web/dev/check-setup-ui.sh",
    "web:dev": "vp dev packages/web",
    "web:build": "vp build packages/web",
    "web:preview": "vp preview packages/web",
    "setup:build": "vp build --config packages/web/dev/setup.config.ts",
    "setup:dev": "vp dev --config packages/web/dev/setup.config.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
